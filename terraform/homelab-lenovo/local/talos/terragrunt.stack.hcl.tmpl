{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab-lenovo" -}}
stack "talos" {
  source = "${find_in_parent_folders("_stacks/talos")}"

  path = "talos"

  values = {
    talos = {
      name       = "{{ .name }}"
      endpoint   = "{{ .endpoint }}"
      dns_server = "{{ .dns_server }}"
      gateway    = "{{ .gateway }}"
{{- if (index . "hardware_addr") }}

      hardware_addr = "{{ .hardware_addr }}"
{{- end }}
{{- if (index . "talos_version") }}

      talos_version = "{{ .talos_version }}"
{{- end }}
{{- if (index . "kubernetes_version") }}

      kubernetes_version = "{{ .kubernetes_version }}"
{{- end }}
{{- if (index . "nvidia_gpu_enabled") }}

      nvidia_gpu_enabled = {{ .nvidia_gpu_enabled }}
{{- end }}
{{- if (index . "system_extensions") }}

      system_extensions = [
{{- range .system_extensions }}
        "{{ . }}",
{{- end }}
      ]
{{- end }}
{{- if (index . "virtiofs_volumes") }}

      virtiofs_volumes = [
{{- range .virtiofs_volumes }}
        "{{ . }}",
{{- end }}
      ]
{{- end }}
{{- if (index . "directory_volumes") }}

      directory_volumes = [
{{- range .directory_volumes }}
        "{{ . }}",
{{- end }}
      ]
{{- end }}

      node_data = {
        controlplanes = {
{{- range .controlplanes }}
          "{{ .ip }}" = {
{{- if (index . "install_disk") }}
            install_disk = "{{ .install_disk }}"
{{- end }}
{{ if (index . "hostname") }}
            hostname = "{{ .hostname }}"
{{- end }}
          }
{{- end }}
        }
      }
      node_subnet    = "{{ .node_subnet }}"
      service_subnet = "{{ .service_subnet }}"
      pod_subnet     = "{{ .pod_subnet }}"
    }

    cluster-bootstrap = {
{{- range .external_secrets }}
{{- if (index . "onepassword") -}}
{{- range .onepassword }}
      namespace         = "{{ .namespace }}"
      vault_name        = "{{ .vault_name }}"
      secret_name       = "{{ .secret_name }}"
      token_secret_name = "{{ .token_secret_name }}"
{{- end }}
{{- end }}
{{- end }}

      argocd_registration = {
        cluster_endpoint = "{{ .endpoint }}"
        vault_name       = "{{ .vault_name }}"
        secret_name      = "argocd-cluster-{{ .name }}"
      }
    }
  }
}
{{- end }}
{{- end }}
