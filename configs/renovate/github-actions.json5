{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "GitHub Actions Renovate config for repos using semantic-release: drop the breaking-change marker from major action updates so they don't trigger a major release",
  packageRules: [
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
    },
  ],
}
