{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Go repo Renovate config: bump the go directive in go.mod and tidy after module updates",
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      description: "Only bump the go directive on new minor Go releases",
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      matchUpdateTypes: ["patch"],
      enabled: false,
    },
  ],
}
