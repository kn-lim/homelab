{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // https://github.com/home-operations/renovate-presets
    "github>home-operations/renovate-presets#10.0.1",
    "github>home-operations/renovate-presets//apps/cnpg.json5#10.0.1",
  ],
  schedule: ["every weekend"],
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      matchDepNames: ["aqua:kubernetes-sigs/kustomize"],
      extractVersion: "^kustomize\\/v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // 1Password does not publish the CLI on GitHub, so look up its versions on the 1password/op image.
      matchDepNames: ["aqua:1password/cli"],
      overrideDatasource: "docker",
      overridePackageName: "1password/op",
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
    },
    {
      // TODO: Remove rule when no longer using a NVIDIA GTX 1080 GPU
      matchDepNames: ["gpu-operator"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
