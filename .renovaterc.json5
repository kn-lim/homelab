{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // https://github.com/home-operations/renovate-presets
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
  ],
  schedule: ["every weekend"],
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      matchDepNames: ["aqua:kubernetes-sigs/kustomize"],
      extractVersion: "^kustomize\\/v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // 1Password does not publish the CLI on GitHub, so look up its versions on the 1password/op image.
      matchDepNames: ["aqua:1password/cli"],
      overrideDatasource: "docker",
      overridePackageName: "1password/op",
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
    },
    {
      // TODO: Remove rule when no longer using a NVIDIA GTX 1080 GPU
      matchDepNames: ["gpu-operator"],
      enabled: false,
    },
  ],
}
