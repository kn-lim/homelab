{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab" -}}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: versitygw
  namespace: versitygw

spec:
  parentRefs:
    - name: traefik
      namespace: traefik
      sectionName: websecure
  hostnames:
    - versitygw.{{ .local_domain }}
  rules:
    - backendRefs:
        - name: versitygw
          port: 7070
{{- end }}
{{- end }}
