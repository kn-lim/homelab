{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab" -}}
apiVersion: builtin
kind: HelmChartInflationGenerator

metadata:
  name: jellyfin

valuesInline:
  jellyfin:
    env:
      - name: JELLYFIN_PublishedServerUrl
        value: "https://jellyfin.{{ .local_domain }}"
  resources:
    limits:
      nvidia.com/gpu: 1

  volumes:
    - name: unraid-media
      nfs:
        server: "{{ .name }}.{{ .local_domain }}"
        path: /mnt/user/media

  volumeMounts:
    - name: unraid-media
      mountPath: /unraid-media
{{- end }}
{{- end }}
