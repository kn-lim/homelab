{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab" -}}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: jellyfin
  namespace: jellyfin

spec:
  parentRefs:
    - name: traefik
      namespace: traefik
      sectionName: websecure
  hostnames:
    - jellyfin.{{ .local_domain }}
  rules:
    - backendRefs:
        - name: jellyfin
          port: 8096
{{- end }}
{{- end }}
