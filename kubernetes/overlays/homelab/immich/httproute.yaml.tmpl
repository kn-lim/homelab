{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab" -}}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: immich
  namespace: immich

spec:
  parentRefs:
    - name: traefik
      namespace: traefik
      sectionName: websecure
  hostnames:
    - immich.{{ .local_domain }}
    - photos.{{ .local_domain }}
  rules:
    - backendRefs:
        - name: immich-server
          port: 2283
{{- end }}
{{- end }}
