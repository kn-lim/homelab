{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab" -}}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: open-webui
  namespace: open-webui

spec:
  parentRefs:
    - name: traefik
      namespace: traefik
      sectionName: websecure
  hostnames:
    - chat.{{ .local_domain }}
    - open-webui.{{ .local_domain }}
  rules:
    - backendRefs:
        - name: open-webui
          port: 80
{{- end }}
{{- end }}
