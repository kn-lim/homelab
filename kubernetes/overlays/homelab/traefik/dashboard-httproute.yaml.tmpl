{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab" -}}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute

metadata:
  name: traefik-dashboard
  namespace: traefik

spec:
  parentRefs:
    - name: traefik
      namespace: traefik
      sectionName: websecure
  hostnames:
    - traefik.{{ .local_domain }}
  rules:
    - backendRefs:
        - name: traefik
          port: 9000
{{- end }}
{{- end }}
