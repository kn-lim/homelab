{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab-lenovo" -}}
{{- $cluster := . -}}
{{- /* clusters.yaml has no host list for Traefik. This list keeps the ArgoCD Traefik overlay unchanged until the cutover. */ -}}
{{- $traefik_hosts := coll.Slice "home-assistant" "traefik" -}}
{{- range $traefik_hosts -}}
---
apiVersion: cert-manager.io/v1
kind: Certificate

metadata:
  name: {{ . }}-{{ $cluster.local_domain | strings.ReplaceAll "." "-" }}
  namespace: traefik

spec:
  secretName: {{ . }}-{{ $cluster.local_domain | strings.ReplaceAll "." "-" }}-tls
  issuerRef:
    name: letsencrypt
    kind: ClusterIssuer
    group: cert-manager.io
  dnsNames:
    - {{ . }}.{{ $cluster.local_domain }}
{{ end -}}
{{- end -}}
{{- end -}}
