{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab-lenovo" -}}
apiVersion: v1
kind: Service

metadata:
  annotations:
    tailscale.com/tailnet-fqdn: idp.{{ .tailscale_tailnet_name }}.ts.net
    tailscale.com/hostname: tsidp-egress-{{ .name }}
  name: tsidp-egress
  namespace: tsidp

spec:
  externalName: placeholder   # will be overwritten by operator
  type: ExternalName
{{- end }}
{{- end }}
