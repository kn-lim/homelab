{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- if eq .name "homelab-lenovo" -}}
apiVersion: builtin
kind: HelmChartInflationGenerator

metadata:
  name: home-assistant

valuesInline:
  configuration:
    templateConfig: |-
      default_config:

      homeassistant:
        internal_url: https://home-assistant.{{ .local_domain }}
        external_url: https://home-assistant.{{ .tailscale_tailnet_name }}.ts.net

      frontend:
        themes: !include_dir_merge_named themes

      automation: !include automations.yaml
      script: !include scripts.yaml
      scene: !include scenes.yaml
{{- end }}
{{- end }}
