{{- $config := (datasource "config") -}}
{{- range $config.clusters -}}
{{- /* Until the rename, the keys in next override the top-level keys. */ -}}
{{- $cluster := . -}}
{{- if has . "next" -}}
{{- $cluster = coll.Merge .next . -}}
{{- end -}}
{{- if eq $cluster.name "ellinia" -}}
{{- $controlplane := index $cluster.controlplanes 0 -}}
apiVersion: v1
kind: ConfigMap

metadata:
  name: cluster-settings
  namespace: flux-system

data:
  CLUSTER_NAME: "{{ $cluster.name }}"
  CONTROLPLANE_IP: "{{ $controlplane.ip }}"
  CONTROLPLANE_HOSTNAME: "{{ $controlplane.hostname }}"
  COREDNS_CLUSTER_IP: "{{ $cluster.coredns_cluster_ip }}"
  DEMOCRATIC_CSI_DATA_PATH: "{{ $cluster.democratic_csi_data_path }}"
  LOCAL_DOMAIN: "{{ $cluster.local_domain }}"
  LOCAL_VIP: "{{ $cluster.local_vip }}"
  POD_SUBNET: "{{ $cluster.pod_subnet }}"
  PROMETHEUS_REMOTE_WRITE_URL: "{{ $cluster.prometheus_remote_write_url }}"
  TAILSCALE_NAMESERVER_IP: "{{ $cluster.tailscale_nameserver_ip }}"
  TAILSCALE_TAILNET_NAME: "{{ $cluster.tailscale_tailnet_name }}"
  VELERO_COLD_BACKUP_BUCKET: "{{ $cluster.velero_cold_backup_bucket }}"
  VELERO_S3_URL: "{{ $cluster.velero_s3_url }}"
{{- end }}
{{- end }}
